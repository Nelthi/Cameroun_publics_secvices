# Configuration du point d'entrée LLM (backend/agents/llm.py).
# Copier ces lignes dans le terminal (export ...) ou dans votre outil de lancement.
# Le choix du LLM reste à décider en équipe : aucun fournisseur n'est imposé.

# --- Option A : serveur compatible OpenAI (OpenAI, Ollama, vLLM, Groq, LM Studio...) ---
export LLM_PROVIDER=openai_compatible
export LLM_MODEL=<nom-du-modele>
export LLM_BASE_URL=http://localhost:11434/v1   # Ollama local ; omis = https://api.openai.com/v1
export LLM_API_KEY=<cle>                        # facultatif pour un serveur local

# --- Option B : API Messages d'Anthropic ---
# export LLM_PROVIDER=anthropic
# export LLM_MODEL=<nom-du-modele>
# export LLM_API_KEY=<cle>

# --- Réglages facultatifs (valeurs par défaut) ---
# export LLM_TEMPERATURE=0.0
# export LLM_MAX_TOKENS=700
# export LLM_TIMEOUT=60
# export LLM_MAX_RETRIES=2
